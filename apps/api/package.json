{
  "name": "@developer-ops/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "github:sync": "tsx src/github/sync-command.ts"
  },
  "dependencies": {
    "@developer-ops/shared": "^0.1.0",
    "@fastify/cors": "^11.3.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.12.5",
    "octokit": "^5.0.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "vitest": "^5.0.1"
  }
}
